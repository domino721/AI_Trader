# Optional: defaults work without copying this file. Never put credentials here.
AI_TRADER_EXECUTION_MODE=simulation
AI_TRADER_STATE_DIR=.local/dev
AI_TRADER_KILL_SWITCH=false
# Optional for data collection. Set a real contact identity in the local .env or cloud settings.
# AI_TRADER_SEC_USER_AGENT=AI_Trader Research <your actual contact email>

# Research operations. Environment names and trading mode are separate.
AI_TRADER_ENVIRONMENT=dev
# New default isolates development state; legacy artifacts are not moved automatically.
# AI_TRADER_STATE_DIR=.local/dev
# Production requires an absolute state path and a protected token (minimum 32 chars).
# Set AI_TRADER_API_TOKEN through a private local file/runtime, never in this tracked example.
AI_TRADER_OPS_SCHEDULE_SECONDS=0
# Capital and loss limits deliberately have no real-money defaults.
# AI_TRADER_CAPITAL_USD=
# AI_TRADER_MAX_DAILY_LOSS_USD=
# AI_TRADER_MAX_DRAWDOWN_FRACTION=
